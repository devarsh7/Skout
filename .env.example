# =============================================================================
# Skout — Environment Variables
# Copy this file to `.env` and fill in the blanks.
# =============================================================================

# ---------- App ----------
APP_NAME=Skout
APP_ENV=development          # development | production
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=8501
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- Database ----------
# SQLite (default, zero-config)
DATABASE_URL=sqlite:///./skout.db
# Postgres (production) — uncomment & set:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/skout

# ---------- Vector DB: Pinecone (ACTIVE) ----------
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=skout-creators
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_DIMENSION=384        # matches all-MiniLM-L6-v2

# ---------- LLM ----------
# Active (FREE): Ollama running locally
LLM_PROVIDER=ollama           # options: ollama | anthropic | openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b      # or qwen2.5:7b, mistral, phi3

# Paid options (uncomment & switch LLM_PROVIDER to use):
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# ---------- Embeddings ----------
EMBEDDING_PROVIDER=local      # options: local | openai
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------- Instagram OAuth ----------
# Get these from developers.facebook.com → Your App → Instagram → Settings
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
INSTAGRAM_REDIRECT_URI=http://localhost:8000/instagram/callback
# For production on Render:
# INSTAGRAM_REDIRECT_URI=https://your-app.onrender.com/instagram/callback

# ---------- Groq (free LLM for creator agent) ----------
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# ---------- MCP ----------
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=9000

# ---------- Email (for outreach feature; use a provider) ----------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ---------- Stripe (future monetization) ----------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID_PRO=price_...
# STRIPE_PRICE_ID_AGENCY=price_...
